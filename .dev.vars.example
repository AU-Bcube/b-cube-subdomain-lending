# 로컬 개발용 설정. `cp .dev.vars.example .dev.vars` 후 사용한다.
# 이 파일의 기본값만으로 OAuth 클라이언트나 Cloudflare 토큰 없이 로컬 UI를 확인할 수 있다.
# .dev.vars는 절대 커밋하지 않는다.

APP_ORIGIN=http://localhost:5173
DEV_FAKE_LOGIN=true
DEV_AUTH_DEBUG=false
DNS_DRY_RUN=true

# 실제 B-CUBE IdP 로그인을 시험할 때만 채운다. redirect_uri는 APP_ORIGIN/auth/callback이다.
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=

# DNS_DRY_RUN=false로 실제 Cloudflare API를 호출할 때만 채운다.
CF_ZONE_ID=
CF_API_TOKEN=

# 쉼표 구분. 개발 모드에서는 admin@ajou.ac.kr이 자동으로 포함된다.
ADMIN_EMAILS=
