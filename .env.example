# 로컬 개발용 설정. `cp .env.example .env` 후 사용한다.
# DB_*만 채우면 OAuth 클라이언트나 Cloudflare 토큰 없이 로컬 UI를 확인할 수 있다.
# .env는 절대 커밋하지 않는다. 운영 값은 Netlify 환경 변수로 넣는다.

# MongoDB 접속 정보(필수, 비밀). 트랜잭션을 쓰므로 복제 세트여야 한다(Atlas는 기본).
DB_CONNECTION_STRING=
DB_NAME=

APP_ORIGIN=http://localhost:5173
DEV_FAKE_LOGIN=true
DEV_AUTH_DEBUG=false
DNS_DRY_RUN=true

# 실제 B-CUBE IdP 로그인을 시험할 때만 채운다. redirect_uri는 APP_ORIGIN/auth/callback이다.
# IDP_ISSUER, IDP_CLIENT_ID의 기본값은 worker/runtime.ts에 있다. 로컬 IdP를 쓸 때만 IDP_ISSUER를 덧붙인다.
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=

# DNS_DRY_RUN=false로 실제 Cloudflare DNS API를 호출할 때만 채운다(DNS 존은 계속 Cloudflare에 있다).
CF_ZONE_ID=
CF_API_TOKEN=

# 로그인에 필요한 소학회 이름. IdP의 소학회 가입내역(sohakoe_memberships)에서 찾는다. 대소문자는 무시한다. 비워 두면 설정 오류.
REQUIRED_SOHAKOE=B-cube

# 쉼표 구분. 개발 모드에서는 admin@ajou.ac.kr이 자동으로 포함된다.
ADMIN_EMAILS=
